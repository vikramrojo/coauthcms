{
  "name": "cogens",
  "version": "0.2.1",
  "description": "A light multi-tenant content store for Cloudflare Workers: every entry may have an owner and every query passes an access check. Forked from Koguma.",
  "license": "MIT",
  "type": "module",
  "author": "Vikram Rojo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikramrojo/cogens.git"
  },
  "bugs": {
    "url": "https://github.com/vikramrojo/cogens/issues"
  },
  "homepage": "https://github.com/vikramrojo/cogens#readme",
  "keywords": [
    "cms",
    "cloudflare",
    "workers",
    "d1",
    "hono",
    "multi-tenant",
    "access-control",
    "casl",
    "content-store"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./migrations-tool": {
      "types": "./dist/migrations-tool/index.d.ts",
      "default": "./dist/migrations-tool/index.js"
    },
    "./scripts/*": "./scripts/*",
    "./package.json": "./package.json",
    "./migrations/*": "./migrations/*"
  },
  "bin": {
    "cogens-print-migration": "./dist/migrations-tool/bin.js"
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "scripts",
    "editor",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun run build && bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "print-migration": "bun run src/migrations-tool/bin.ts",
    "build:editor": "bun run scripts/build-admin-editor.ts",
    "prepublishOnly": "bun run build && bun test",
    "example:migrate": "wrangler d1 migrations apply DB --local -c examples/worker/wrangler.jsonc",
    "example:dev": "wrangler dev -c examples/worker/wrangler.jsonc"
  },
  "dependencies": {
    "@casl/ability": "7.1.3",
    "@cfworker/json-schema": "^4.1.1",
    "hono": "~4.12.2"
  },
  "peerDependencies": {
    "@milkdown/crepe": "^7.23.0",
    "miniflare": "^4.20260301.1"
  },
  "peerDependenciesMeta": {
    "miniflare": {
      "optional": true
    },
    "@milkdown/crepe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260304.0",
    "@milkdown/crepe": "^7.23.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "miniflare": "^4.20260301.1",
    "remark-directive": "^4.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.71.0"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts"
}
